# Keep false until PostgreSQL, private bucket, Sheet and service account are ready.
SUBMISSION_ARCHIVE_ENABLED=false
REPORT_SHEETS_ENABLED=false
DATABASE_URL=
PUBLIC_APP_URL=https://script-engine-production-c761.up.railway.app
ADMIN_TOKEN=

# Copy credentials from the private S3-compatible bucket. Never commit actual values.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Railway Buckets use virtual-hosted style. Set true only if your provider requires it.
S3_FORCE_PATH_STYLE=false

# Entire JSON service-account credential as one Railway secret variable.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The ID between /d/ and /edit in the spreadsheet URL, not the full URL.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Submissions

# Existing AI configuration remains unchanged.
WRITING_PROVIDER=openai
SKILL_SOURCE=original
OPENAI_API_KEY=

# AI Agent Lab monitoring (optional): enables GET /internal/monitoring for the Lab's
# Performance → Status tab. Use a random secret of at least 32 characters; unset = disabled.
LAB_MONITORING_TOKEN=
